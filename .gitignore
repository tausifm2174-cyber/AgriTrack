# ==============================================================================
# AgriTrack .gitignore
# ==============================================================================

# Node / React / Vite
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/

# Java / Maven
target/
**/target/
*.class
.mvn/timing.properties

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Spring Boot local configuration
application-local.properties
application-secret.properties
**/application-local.properties
**/application-secret.properties

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
**/.idea/
*.iml
**/*.iml
.project
.classpath
.settings/
**/.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS & Temporary files
.DS_Store
Thumbs.db
desktop.ini
**/desktop.ini
