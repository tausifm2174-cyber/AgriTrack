# ==============================================================================
# AgriTrack Backend - Environment Variables Example
# Phase 13: Spring Boot Backend + MySQL Foundation
#
# IMPORTANT:
# Spring Boot does NOT automatically load .env files.
# This file is an example template for local development configuration.
# DO NOT store real passwords or secrets in version control.
#
# To set these variables in Windows PowerShell prior to running the backend:
#   $env:DB_URL="jdbc:mysql://localhost:3306/agritrack_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8"
#   $env:DB_USERNAME="agritrack_user"
#   $env:DB_PASSWORD="your_mysql_password_here"
#   $env:SERVER_PORT="8080"
#   $env:FRONTEND_ORIGIN="http://localhost:5173"
# ==============================================================================

# MySQL Database JDBC Connection URL
DB_URL=jdbc:mysql://localhost:3306/agritrack_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# MySQL Database Username (Use dedicated application user, NOT 'root')
DB_USERNAME=agritrack_user

# MySQL Database Password (Replace with the password configured for agritrack_user)
DB_PASSWORD=your_mysql_password_here

# Backend Embedded Server Port (Default: 8080)
SERVER_PORT=8080

# Allowed Frontend Origin for CORS (Vite default is http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
